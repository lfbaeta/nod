{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://nod.n8n.io/docs/schemas/apps/v1/app.schema.json"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "icon": {
      "type": "string",
      "pattern": "^\\.\\/io\\.n8n\\.nod\\/(?:[a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+\\.(?:svg|png|webp)$"
    },
    "categories": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "prompts": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "requirements": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "connection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mcp"
            },
            "server": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "authentication": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "const": "oauth2"
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "scopes": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": ["type", "server", "authentication"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mcp"
            },
            "server": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "authentication": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "enum": ["bearer", "x-api-key"]
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": ["type", "server", "authentication"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mcp"
            },
            "endpoint": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "owner"
                },
                "path": {
                  "type": "string",
                  "pattern": "^\\/(?:[a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+$"
                }
              },
              "required": ["source", "path"],
              "additionalProperties": false
            },
            "authentication": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "const": "oauth2"
                },
                {
                  "type": "string",
                  "const": "bearer"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["type", "endpoint", "authentication"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["$schema", "displayName", "prompts", "requirements", "limitations", "connection"],
  "additionalProperties": false,
  "$id": "https://nod.n8n.io/docs/schemas/apps/v1/app.schema.json",
  "title": "Nod app profile v1"
}
